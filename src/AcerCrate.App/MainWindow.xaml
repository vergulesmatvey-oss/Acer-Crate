<Window x:Class="AcerCrate.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="using:AcerCrate.App.Services" xmlns:controls="using:AcerCrate.App.Controls" Title="Acer Crate" xmlns:l="using:AcerCrate.App.Localization">
    <Grid x:Name="RootGrid" Background="{ThemeResource CrateRail}">
        <Grid.Resources>
            <Style x:Key="CaptionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Height="34" Background="{ThemeResource CrateRail}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource CaptionButtonStyle}" Width="48" Click="OnPaneToggleRequested" AutomationProperties.Name="{l:Text Key=Crate194}" ToolTipService.ToolTip="{l:Text Key=Crate194}">
                <FontIcon Glyph="" FontSize="14" />
            </Button>
            <Border x:Name="TitleDragRegion" Grid.Column="1" Background="Transparent">
                <TextBlock Text="Acer Crate" FontSize="14" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButtonStyle}" Click="OnMinimizeRequested" AutomationProperties.Name="{l:Text Key=Crate193}" ToolTipService.ToolTip="{l:Text Key=Crate193}">
                    <FontIcon Glyph="" FontSize="10" />
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Click="OnMaximizeRequested" AutomationProperties.Name="{l:Text Key=Crate173}" ToolTipService.ToolTip="{l:Text Key=Crate174}">
                    <FontIcon x:Name="MaximizeIcon" Glyph="" FontSize="10" />
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CaptionButtonStyle}" Click="OnCloseRequested" AutomationProperties.Name="{l:Text Key=Crate206}" ToolTipService.ToolTip="{l:Text Key=Crate206}">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C42B1C" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A92217" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                    </Button.Resources>
                    <FontIcon Glyph="" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="False" OpenPaneLength="230" PaneDisplayMode="Left" IsPaneOpen="True" SelectionChanged="OnNavigationChanged" Visibility="{x:Bind Shell.IsReady, Mode=OneWay}">

        <NavigationView.Resources>
            <x:Double x:Key="NavigationViewSelectionIndicatorHeight">44</x:Double>
            <x:Double x:Key="NavigationViewSelectionIndicatorWidth">3</x:Double>
            <x:Double x:Key="NavigationViewSelectionIndicatorRadius">0</x:Double>
            <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">16</x:Double>
            <Thickness x:Key="NavigationViewItemButtonMargin">0,1,0,1</Thickness>
            <Thickness x:Key="NavigationViewItemMargin">0</Thickness>
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#12E1D2" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#12FFFFFF" />
            <LinearGradientBrush x:Key="NavigationViewItemBackgroundSelected" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#3412E1D2" />
                <GradientStop Offset="0.62" Color="#1412E1D2" />
                <GradientStop Offset="1" Color="Transparent" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#3412E1D2" />
                <GradientStop Offset="0.62" Color="#1412E1D2" />
                <GradientStop Offset="1" Color="Transparent" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="NavigationViewItemBackgroundSelectedPressed" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#3412E1D2" />
                <GradientStop Offset="0.62" Color="#1412E1D2" />
                <GradientStop Offset="1" Color="Transparent" />
            </LinearGradientBrush>
        </NavigationView.Resources>
        <NavigationView.MenuItems>
<NavigationViewItemHeader Content="{l:Text Key=Crate245}" />
<controls:CrateNavItem Title="{l:Text Key=Crate046}" Tag="dashboard"><controls:CrateNavItem.Icon><PathIcon Data="F0 M12 2 L22 10 V22 H14 V15 H10 V22 H2 V10 Z M4 11 V20 H8 V13 H16 V20 H20 V11 L12 4 Z" /></controls:CrateNavItem.Icon></controls:CrateNavItem>
<controls:CrateNavItem Title="{l:Text Key=Crate126}" Tag="fans"><controls:CrateNavItem.Icon><PathIcon Data="M11 10 C5 10 3 6 6 3 C10 0 15 4 14 9 Z M14 11 C19 7 23 9 22 14 C21 19 17 20 14 15 Z M11 14 C13 20 8 24 4 20 C0 16 4 12 9 12 Z M14 12 A2 2 0 1 1 10 12 A2 2 0 1 1 14 12 Z" /></controls:CrateNavItem.Icon></controls:CrateNavItem>
<controls:CrateNavItem Title="{l:Text Key=Crate141}" Tag="lighting"><controls:CrateNavItem.Icon><PathIcon Data="F0 M12 2 A7 7 0 0 1 17 14 L16 17 H8 L7 14 A7 7 0 0 1 12 2 Z M12 4 A5 5 0 0 0 9 13 L10 15 H14 L15 13 A5 5 0 0 0 12 4 Z M8 19 H16 V21 H8 Z M10 22 H14 V24 H10 Z" /></controls:CrateNavItem.Icon></controls:CrateNavItem>
<controls:CrateNavItem Title="{l:Text Key=Crate134}" Tag="system"><controls:CrateNavItem.Icon><PathIcon Data="M13 1 L4 14 H11 L10 23 L21 9 H14 L15 1 Z" /></controls:CrateNavItem.Icon></controls:CrateNavItem>
<NavigationViewItemHeader Content="{l:Text Key=Crate085}" />
<controls:CrateNavItem x:Name="LibraryNav" Title="Game library" Tag="library"><controls:CrateNavItem.Icon><FontIcon Glyph="&#xE7FC;" /></controls:CrateNavItem.Icon></controls:CrateNavItem>
<controls:CrateNavItem Title="{l:Text Key=Crate152}" Tag="presets"><controls:CrateNavItem.Icon><PathIcon Data="F0 M2 2 H11 V11 H2 Z M4 4 V9 H9 V4 Z M14 2 H23 V11 H14 Z M16 4 V9 H21 V4 Z M2 14 H11 V23 H2 Z M4 16 V21 H9 V16 Z M14 14 H23 V23 H14 Z M16 16 V21 H21 V16 Z" /></controls:CrateNavItem.Icon></controls:CrateNavItem>
<controls:CrateNavItem Title="{l:Text Key=Crate012}" Tag="automation"><controls:CrateNavItem.Icon><PathIcon Data="M11 2 H13 V6 H18 V11 H22 V13 H18 V18 H13 V22 H11 V18 H6 V13 H2 V11 H6 V6 H11 Z M8 8 V16 H16 V8 Z" /></controls:CrateNavItem.Icon></controls:CrateNavItem>
<NavigationViewItemHeader Content="{l:Text Key=Crate203}" />
<controls:CrateNavItem x:Name="GraphicsNav" Title="Graphics" Tag="graphics"><controls:CrateNavItem.Icon><FontIcon Glyph="&#xE7F4;" /></controls:CrateNavItem.Icon></controls:CrateNavItem>
<controls:CrateNavItem x:Name="LogsNav" Title="Logs" Tag="logs"><controls:CrateNavItem.Icon><FontIcon Glyph="&#xE9D9;" /></controls:CrateNavItem.Icon></controls:CrateNavItem>
<controls:CrateNavItem Title="{l:Text Key=Crate088}" Tag="monitoring"><controls:CrateNavItem.Icon><PathIcon Data="M2 2 H4 V20 H23 V22 H2 Z M6 15 L10 9 L14 12 L20 4 L22 6 L14 15 L10 12 L8 17 Z" /></controls:CrateNavItem.Icon></controls:CrateNavItem>
<controls:CrateNavItem Title="{l:Text Key=Crate051}" Tag="diagnostics"><controls:CrateNavItem.Icon><PathIcon Data="F0 M4 1 H15 L21 7 V23 H4 Z M6 3 V21 H19 V9 H13 V3 Z M15 4 V7 H18 Z M8 11 H17 V13 H8 Z M8 16 H17 V18 H8 Z" /></controls:CrateNavItem.Icon></controls:CrateNavItem>
</NavigationView.MenuItems>
<NavigationView.FooterMenuItems><controls:CrateNavItem Title="{l:Text Key=Crate098}" Tag="settings"><controls:CrateNavItem.Icon><PathIcon Data="F0 M10 1 H14 L15 5 L19 5 L22 9 L19 12 L22 15 L19 19 L15 19 L14 23 H10 L9 19 H5 L2 15 L5 12 L2 9 L5 5 H9 Z M12 7 A5 5 0 1 0 12 17 A5 5 0 1 0 12 7 Z" /></controls:CrateNavItem.Icon></controls:CrateNavItem></NavigationView.FooterMenuItems>

            <Grid Background="{ThemeResource CrateSurface}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="36,8,36,0">
                    <!-- Update available (closing it means "later") -->
                    <InfoBar Title="{x:Bind Updates.BannerTitle, Mode=OneWay}" Margin="0,0,0,8" IsOpen="{x:Bind Updates.BannerOpen, Mode=TwoWay}" Message="{x:Bind Updates.BannerMessage, Mode=OneWay}" Severity="Informational">
                        <InfoBar.ActionButton>
                            <Button x:Uid="Update_Install" Command="{x:Bind Updates.InstallCommand}" Style="{StaticResource AccentButtonStyle}" />
                        </InfoBar.ActionButton>
                        <StackPanel Margin="0,0,0,12" Spacing="4">
                            <controls:PinnedProgressBar Maximum="1" Visibility="{x:Bind Updates.IsDownloading, Mode=OneWay}" Value="{x:Bind Updates.DownloadProgress, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <HyperlinkButton x:Uid="Update_WhatsNew" Command="{x:Bind Updates.OpenReleasePageCommand}" />
                                <HyperlinkButton x:Uid="Update_Skip" Command="{x:Bind Updates.SkipCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </InfoBar>
                    <!-- A page that could not be opened (its text and button are set when that happens) -->
                    <InfoBar x:Name="NavigationFailedBar" Margin="0,0,0,8" IsOpen="False" Severity="Error">
                        <InfoBar.ActionButton>
                            <Button x:Name="NavigationRetryButton" Click="OnNavigationRetry" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <ItemsControl ItemsSource="{x:Bind Shell.Notices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:Notice">
                                <InfoBar Title="{x:Bind Title}" Margin="0,0,0,8" CloseButtonClick="OnNoticeClosed" IsOpen="True" Message="{x:Bind Message}" Severity="{x:Bind Severity}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>

        <Border x:Name="SidebarDivider" Grid.Row="1" Width="1" HorizontalAlignment="Left" Margin="230,0,0,0"
                Background="{ThemeResource CrateRule}" Opacity="0.65" IsHitTestVisible="False" Visibility="{x:Bind Shell.IsReady, Mode=OneWay}" />

        <!-- Startup -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Visibility="{x:Bind Shell.IsStarting, Mode=OneWay}">
            <ProgressRing Width="48" Height="48" IsActive="True" />
            <TextBlock x:Uid="Startup_Connecting" Style="{StaticResource BodyTextBlockStyle}" />
        </StackPanel>

        <!-- Problems -->
        <StackPanel Grid.Row="1" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind Shell.ShowProblem, Mode=OneWay}">
            <Image Width="72" Height="72" Source="ms-appx:///Assets/AcerCrate.png" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Shell.ProblemTitle, Mode=OneWay}" />
            <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Shell.ProblemMessage, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Margin="0,8,0,0" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Button x:Uid="Problem_RestartElevated" Command="{x:Bind Shell.RetryElevationCommand}" Style="{StaticResource AccentButtonStyle}" Visibility="{x:Bind Shell.CanRetryElevation, Mode=OneWay}" />
                <Button x:Uid="Problem_StartService" Command="{x:Bind Shell.StartServiceCommand}" Style="{StaticResource AccentButtonStyle}" Visibility="{x:Bind Shell.CanStartService, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
