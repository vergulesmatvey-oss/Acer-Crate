<Page x:Class="AcerCrate.App.Views.CrateHomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="using:AcerCrate.App.Controls"
      xmlns:l="using:AcerCrate.App.Localization"
      NavigationCacheMode="Enabled" Background="{ThemeResource CrateSurface}">
  <Page.Resources>
    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
    <Style x:Key="MetricLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="MetricValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style x:Key="MetricTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="27" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
      <Setter Property="FontWeight" Value="SemiLight" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
  </Page.Resources>
  <ScrollView>
    <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="36,14,36,36" Spacing="24">
      <c:PageHeading Title="{l:Text Key=Crate046}" Glyph="&#xE80F;" ShowRule="False" />
      <Grid x:Name="OverviewColumns" ColumnSpacing="44" SizeChanged="OnOverviewSizeChanged">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.9*" />
          <ColumnDefinition Width="1.4*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="Hero" Spacing="16" Padding="0,8,0,0" VerticalAlignment="Bottom">
          <c:LaptopPortrait x:Name="LaptopImage" Height="214" MaxWidth="440" HorizontalAlignment="Stretch"
                            Visibility="Collapsed" />
          <StackPanel Spacing="7" Margin="0,2,0,0">
            <TextBlock x:Name="Model" FontFamily="ms-appx:///Assets/Fonts/Orbitron-Black.ttf#Orbitron"
                       FontSize="25" FontWeight="Black" CharacterSpacing="12" TextAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Spacing="4">
              <TextBlock x:Name="CpuName" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" FontWeight="Normal"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock x:Name="GpuName" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" FontWeight="Normal"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <TextBlock x:Name="ArtworkStatus" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
          </StackPanel>
          <c:HomeGames Margin="0,26,0,0" />
        </StackPanel>

        <StackPanel x:Name="MonitorArea" Grid.Column="1" Spacing="15" VerticalAlignment="Bottom">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Path Width="18" Height="8" Stretch="Fill" Fill="{ThemeResource CrateAccent}"
                  Data="M0 0 H12 L20 8 H8 Z M16 0 H21 L29 8 H24 Z" VerticalAlignment="Center" />
            <TextBlock Text="{l:Text Key=Crate204}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <c:TileGrid MinColumnWidth="226" MaxColumns="2" Spacing="26">
            <StackPanel Spacing="10">
              <TextBlock Text="CPU" Style="{StaticResource MetricTitle}" />
              <StackPanel Spacing="5">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{l:Text Key=HomeLoad}" Style="{StaticResource MetricLabel}" />
                  <TextBlock Grid.Column="1" x:Name="CpuLoad" Text="—" Style="{StaticResource MetricValue}" />
                </Grid>
                <c:CrateMeter x:Name="CpuLoadBar" AutomationProperties.Name="CPU" />
              </StackPanel>
              <StackPanel Spacing="5">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{l:Text Key=Crate230}" Style="{StaticResource MetricLabel}" />
                  <TextBlock Grid.Column="1" x:Name="CpuTemp" Text="—" Style="{StaticResource MetricValue}" />
                </Grid>
                <c:CrateMeter x:Name="CpuTemperatureBar" Maximum="100" AutomationProperties.Name="{l:Text Key=Crate231}" />
              </StackPanel>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Text Key=Crate134}" Style="{StaticResource MetricLabel}" />
                <TextBlock Grid.Column="1" x:Name="Supply" Text="—" Style="{StaticResource MetricValue}" />
              </Grid>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Text Key=Voltage}" Style="{StaticResource MetricLabel}" />
                <TextBlock Grid.Column="1" Text="—" Style="{StaticResource MetricValue}"
                           ToolTipService.ToolTip="{l:Text Key=CpuVoltageUnavailable}" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Text="GPU" Style="{StaticResource MetricTitle}" />
              <StackPanel Spacing="5">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{l:Text Key=HomeLoad}" Style="{StaticResource MetricLabel}" />
                  <TextBlock Grid.Column="1" x:Name="GpuLoad" Text="—" Style="{StaticResource MetricValue}" />
                </Grid>
                <c:CrateMeter x:Name="GpuLoadBar" AutomationProperties.Name="GPU" />
              </StackPanel>
              <StackPanel Spacing="5">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{l:Text Key=Crate230}" Style="{StaticResource MetricLabel}" />
                  <TextBlock Grid.Column="1" x:Name="GpuTemp" Text="—" Style="{StaticResource MetricValue}" />
                </Grid>
                <c:CrateMeter x:Name="GpuTemperatureBar" Maximum="100" AutomationProperties.Name="{l:Text Key=Crate230}" />
              </StackPanel>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Text Key=Crate210}" Style="{StaticResource MetricLabel}" />
                <TextBlock Grid.Column="1" x:Name="GpuState" Text="—" Style="{StaticResource MetricValue}" />
              </Grid>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Text Key=Voltage}" Style="{StaticResource MetricLabel}" />
                <TextBlock Grid.Column="1" x:Name="GpuVoltage" Text="—" Style="{StaticResource MetricValue}" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Text="{l:Text Key=Crate030}" Style="{StaticResource MetricTitle}" />
              <c:HomeFanControls />
              <c:FanNoiseMeter />
              <Button Content="{l:Text Key=Crate127}" Click="OpenCooling" Background="Transparent"
                      CornerRadius="4" Padding="10,4" MinHeight="28" FontSize="12" />
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Text="{l:Text Key=Crate130}" Style="{StaticResource MetricTitle}" />
              <StackPanel Spacing="5">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{l:Text Key=Crate121}" Style="{StaticResource MetricLabel}" />
                  <TextBlock Grid.Column="1" x:Name="Ram" Text="—" Style="{StaticResource MetricValue}" />
                </Grid>
                <c:CrateMeter x:Name="RamBar" AutomationProperties.Name="{l:Text Key=Crate121}" />
              </StackPanel>
              <StackPanel Spacing="5">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="DiskLabel" Text="{l:Text Key=Crate082}" Style="{StaticResource MetricLabel}" />
                  <TextBlock Grid.Column="1" x:Name="Disk" Text="—" Style="{StaticResource MetricValue}" />
                </Grid>
                <c:CrateMeter x:Name="DiskBar" AutomationProperties.Name="{l:Text Key=Crate082}" />
              </StackPanel>
            </StackPanel>
          </c:TileGrid>

          <c:ModePanel x:Name="HomeModes" ShowSelectionRule="True" />
        </StackPanel>
        <StackPanel x:Name="ModeFeedback" Grid.Row="1" Grid.Column="1" Margin="0,9,0,0" />
      </Grid>

      <StackPanel Spacing="14" Margin="0,5,0,0">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{l:Text Key=Crate071}" FontSize="15" FontWeight="SemiBold"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="{l:Text Key=Crate037}" Click="OpenMonitoring"
                  Background="Transparent" CornerRadius="4" Padding="10,4" MinHeight="28" FontSize="12" />
        </Grid>
        <c:TileGrid MinColumnWidth="340" MaxColumns="2" Spacing="24">
          <StackPanel Spacing="7">
            <TextBlock Text="{l:Text Key=Crate231}" Style="{StaticResource MetricLabel}" />
            <c:HistoryChart Height="180" Minimum="0" Maximum="100" ShowAxes="True" AxisUnit="°C"
                            Series="{x:Bind Monitor.CpuHistory}" Revision="{x:Bind Monitor.Revision, Mode=OneWay}" />
          </StackPanel>
          <StackPanel Spacing="7">
            <TextBlock Text="{l:Text Key=Crate060}" Style="{StaticResource MetricLabel}" />
            <c:HistoryChart Height="180" Minimum="0" Maximum="100" ShowAxes="True" AxisUnit="%"
                            UseTemperatureColors="False" Series="{x:Bind Monitor.CpuLoadHistory}"
                            Revision="{x:Bind Monitor.Revision, Mode=OneWay}" />
          </StackPanel>
        </c:TileGrid>
      </StackPanel>
    </StackPanel>
  </ScrollView>
</Page>
