<Page x:Class="OpenSense.App.Views.CrateHomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:OpenSense.App.Controls" NavigationCacheMode="Enabled" Background="{ThemeResource CrateSurface}" xmlns:l="using:OpenSense.App.Localization">
  <Page.Resources>
    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
    <Style x:Key="HomeCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Page.Resources>
  <ScrollView>
    <Grid x:Name="Layout" Padding="30,14,30,28" RowSpacing="22" ColumnSpacing="30">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="HeroCol" Width="0.84*" />
        <ColumnDefinition Width="1.35*" />
      </Grid.ColumnDefinitions>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
          <VisualState x:Name="Wide">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="1050" />
            </VisualState.StateTriggers>
          </VisualState>
          <VisualState x:Name="Expanded">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="1500" />
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="LaptopImage.Height" Value="300" />
              <Setter Target="LaptopImage.MaxWidth" Value="540" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Narrow">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="0" />
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="HeroCol.Width" Value="0" />
              <Setter Target="Hero.(Grid.Column)" Value="1" />
              <Setter Target="MonitorArea.(Grid.Row)" Value="2" />
              <Setter Target="Layout.ColumnSpacing" Value="0" />
              <Setter Target="HistoryArea.(Grid.Row)" Value="3" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <TextBlock Grid.ColumnSpan="2" Text="{l:Text Key=Crate046}" FontSize="25" FontWeight="SemiBold" />
      <StackPanel x:Name="Hero" Grid.Row="1" Spacing="18" Padding="0,12,0,0">
        <TextBlock x:Name="Model" HorizontalAlignment="Center" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
        <StackPanel Spacing="3">
          <TextBlock x:Name="CpuName" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Opacity=".75" />
          <TextBlock x:Name="GpuName" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Opacity=".75" />
        </StackPanel>
        <Image x:Name="LaptopImage" Height="250" MaxWidth="440" Margin="0,20,0,0" Stretch="Uniform" Visibility="Collapsed" />
        <TextBlock x:Name="ArtworkStatus" FontSize="12" Opacity=".6" TextAlignment="Center" TextWrapping="Wrap" />
        <Border Style="{StaticResource HomeCardStyle}" Padding="18" Margin="0,14,0,0" MaxWidth="480" HorizontalAlignment="Stretch">
          <StackPanel Spacing="12">
            <TextBlock Text="{l:Text Key=Crate095}" FontSize="16" FontWeight="SemiBold" />
            <StackPanel x:Name="DriveDetails" Spacing="16" />
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel x:Name="MonitorArea" Grid.Row="1" Grid.Column="1" Spacing="16">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Path Width="22" Height="9" Stretch="Fill" Fill="{ThemeResource CrateAccent}" Data="M0 0 H4 L12 9 H8 Z M7 0 H11 L19 9 H15 Z M14 0 H18 L26 9 H22 Z" />
          <TextBlock Text="{l:Text Key=Crate204}" FontSize="15" FontWeight="SemiBold" />
        </StackPanel>
        <Grid ColumnSpacing="12" RowSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource HomeCardStyle}" Padding="14" Grid.Row="0" Grid.Column="0">
            <StackPanel Spacing="10">
              <Grid>
                <TextBlock Text="CPU" FontSize="26" FontWeight="Light" />
                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="10" Stretch="Fill" Fill="{ThemeResource CrateRule}" Data="M0 0 H3 L13 10 H10 Z M8 0 H11 L21 10 H18 Z M16 0 H19 L29 10 H26 Z" />
              </Grid>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Text Key=Crate059}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" x:Name="CpuLoad" FontSize="13" Text="—" />
              </Grid>
              <c:PinnedProgressBar x:Name="CpuLoadBar" Height="3" Minimum="0" Maximum="100" CornerRadius="0" Foreground="{ThemeResource CrateAccent}" Background="{ThemeResource CrateRule}" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Text Key=Crate230}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" x:Name="CpuTemp" FontSize="13" Text="—" />
              </Grid>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Text Key=Crate134}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" x:Name="Supply" FontSize="13" Text="—" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource HomeCardStyle}" Padding="14" Grid.Row="0" Grid.Column="1">
            <StackPanel Spacing="10">
              <Grid>
                <TextBlock Text="GPU" FontSize="26" FontWeight="Light" />
                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="10" Stretch="Fill" Fill="{ThemeResource CrateRule}" Data="M0 0 H3 L13 10 H10 Z M8 0 H11 L21 10 H18 Z M16 0 H19 L29 10 H26 Z" />
              </Grid>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Text Key=Crate059}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" x:Name="GpuLoad" FontSize="13" Text="—" />
              </Grid>
              <c:PinnedProgressBar x:Name="GpuLoadBar" Height="3" Minimum="0" Maximum="100" CornerRadius="0" Foreground="{ThemeResource CrateAccent}" Background="{ThemeResource CrateRule}" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Text Key=Crate230}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" x:Name="GpuTemp" FontSize="13" Text="—" />
              </Grid>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Text Key=Crate210}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" x:Name="GpuState" FontSize="13" Text="—" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource HomeCardStyle}" Padding="14" Grid.Row="1" Grid.Column="0">
            <StackPanel Spacing="10">
              <Grid>
                <TextBlock Text="{l:Text Key=Crate030}" FontSize="26" FontWeight="Light" />
                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="10" Stretch="Fill" Fill="{ThemeResource CrateRule}" Data="M0 0 H3 L13 10 H10 Z M8 0 H11 L21 10 H18 Z M16 0 H19 L29 10 H26 Z" />
              </Grid>
              <c:HomeFanControls />
              <Rectangle Height="1" Fill="{ThemeResource CrateRule}" />
              <Button Content="{l:Text Key=Crate127}" Click="OpenCooling" Background="Transparent" CornerRadius="0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource HomeCardStyle}" Padding="14" Grid.Row="1" Grid.Column="1">
            <StackPanel Spacing="10">
              <Grid>
                <TextBlock Text="{l:Text Key=Crate130}" FontSize="26" FontWeight="Light" />
                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="10" Stretch="Fill" Fill="{ThemeResource CrateRule}" Data="M0 0 H3 L13 10 H10 Z M8 0 H11 L21 10 H18 Z M16 0 H19 L29 10 H26 Z" />
              </Grid>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Text Key=Crate121}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" x:Name="Ram" FontSize="13" Text="—" />
              </Grid>
              <c:PinnedProgressBar x:Name="RamBar" Height="3" Minimum="0" Maximum="100" CornerRadius="0" Foreground="{ThemeResource CrateAccent}" Background="{ThemeResource CrateRule}" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DiskLabel" Text="{l:Text Key=Crate082}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" x:Name="Disk" FontSize="13" Text="—" />
              </Grid>
              <c:PinnedProgressBar x:Name="DiskBar" Height="3" Minimum="0" Maximum="100" CornerRadius="0" Foreground="{ThemeResource CrateAccent}" Background="{ThemeResource CrateRule}" />
            </StackPanel>
          </Border>
        </Grid>
        <Rectangle Height="1" Margin="0,4,0,0" Fill="{ThemeResource CrateRule}" />
        <Border Style="{StaticResource HomeCardStyle}" Padding="14">
          <c:ModePanel />
        </Border>
      </StackPanel>
      <StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:OpenSense.App.Controls" xmlns:l="using:OpenSense.App.Localization" x:Name="HistoryArea" Grid.Row="2" Grid.ColumnSpan="2" Spacing="12">
        <Grid>
          <TextBlock Text="{l:Text Key=Crate071}" FontSize="16" FontWeight="SemiBold" />
          <Button Content="{l:Text Key=Crate037}" Click="OpenMonitoring" HorizontalAlignment="Right" Background="Transparent" />
        </Grid>
        <c:TileGrid MinColumnWidth="340" MaxColumns="2" Spacing="20">
          <Border Style="{StaticResource HomeCardStyle}">
            <StackPanel Spacing="8">
              <TextBlock Text="{l:Text Key=Crate231}" FontSize="13" />
              <c:HistoryChart Height="180" Minimum="0" Maximum="100" ShowAxes="True" AxisUnit="°C" Series="{x:Bind Monitor.CpuHistory}" Revision="{x:Bind Monitor.Revision, Mode=OneWay}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource HomeCardStyle}">
            <StackPanel Spacing="8">
              <TextBlock Text="{l:Text Key=Crate060}" FontSize="13" />
              <c:HistoryChart Height="180" Minimum="0" Maximum="100" ShowAxes="True" AxisUnit="%" UseTemperatureColors="False" Series="{x:Bind Monitor.CpuLoadHistory}" Revision="{x:Bind Monitor.Revision, Mode=OneWay}" />
            </StackPanel>
          </Border>
        </c:TileGrid>
      </StackPanel>
    </Grid>
  </ScrollView>
</Page>
